# Copia este archivo como .env (o .env.local) y ajústalo. Ninguno de los dos se sube al repo.
# Todo es configuración pública que se incluye en el build: NO pongas secretos aquí.
# Si no existe .env, se usan estos mismos valores por defecto.

# Nombre de la app (título, manifest de la PWA, textos de la UI)
VITE_APP_NAME=LaLaLa
VITE_APP_SHORT_NAME=LaLaLa

# Ícono fuente (SVG recomendado, cuadrado, relativo a la raíz del proyecto).
# De aquí se generan favicon, apple-touch-icon y los PNG del manifest en cada build.
VITE_APP_ICON=public/icon.svg

# URL de Jellyfin precargada en el login (opcional), p. ej. https://jellyfin.midominio.com
VITE_DEFAULT_SERVER_URL=
